<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Zarcillo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_zarcillo._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Zarcillo usa la cámara para leer texto y escanear pizarras o apuntes hacia tu Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Zarcillo busca tu Mac en la red Wi-Fi para controlarlo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Zarcillo escucha la clase para transcribirla en tu Mac, y tus órdenes de voz.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Zarcillo guarda en Fotos el póster de la canción que estás escuchando.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>La transcripción se hace en el propio iPhone, sin internet.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
